{
 "target": "fare",
 "raw_inputs": [
  "airline",
  "travel_class",
  "source",
  "destination",
  "stops",
  "duration_hours",
  "days_left",
  "dep_minutes"
 ],
 "excluded": {
  "fare": "target",
  "row_id": "row identifier",
  "flight_code": "identifier of a recurring flight (1,405 levels, determines airline): memorisation risk (Decision)",
  "journey_date": "days_left is a one-to-one function of it (single booking date); keeping both lets a model memorise dates",
  "weekday": "function of journey_date; Economy variance share 0.003 (Phase 3)",
  "arr_minutes": "exactly (dep_minutes + duration) mod 24h in 100% of rows: redundant",
  "dep_bucket": "exact function of dep_minutes",
  "arr_bucket": "exact function of arr_minutes",
  "block": "split bookkeeping"
 },
 "features": [
  {
   "name": "airline",
   "type": "categorical (9)",
   "pipelines": "tree, linear",
   "derivation": "raw",
   "rationale": "eta^2 0.274 pooled / 0.235 Economy"
  },
  {
   "name": "travel_class",
   "type": "categorical (3: Economy, Premium Economy, Business)",
   "pipelines": "tree, linear",
   "derivation": "raw",
   "rationale": "eta^2 0.755: dominant driver; First excluded (n=144)"
  },
  {
   "name": "source",
   "type": "categorical (7)",
   "pipelines": "tree, linear",
   "derivation": "raw",
   "rationale": "route/market effect"
  },
  {
   "name": "destination",
   "type": "categorical (7)",
   "pipelines": "tree, linear",
   "derivation": "raw",
   "rationale": "route/market effect"
  },
  {
   "name": "stops",
   "type": "ordinal (non-stop<1-stop<2+-stop)",
   "pipelines": "tree: ordinal 0/1/2; linear: one-hot",
   "derivation": "raw",
   "rationale": "Economy medians 5,737 / 10,075 / 12,925 are not evenly spaced, so the linear model uses one-hot"
  },
  {
   "name": "duration_hours",
   "type": "numeric",
   "pipelines": "tree, linear",
   "derivation": "raw",
   "rationale": "r=0.33 with fare in Economy"
  },
  {
   "name": "days_left",
   "type": "numeric 1-50",
   "pipelines": "tree, linear",
   "derivation": "raw",
   "rationale": "the only lead-time signal; equals journey date minus 2023-01-15 in training"
  },
  {
   "name": "dep_minutes",
   "type": "numeric 0-1439",
   "pipelines": "tree, linear",
   "derivation": "raw (exact clock time)",
   "rationale": "replaces the 4 coarse buckets; weak signal (|r|<0.05)"
  },
  {
   "name": "route_ref_duration_hours",
   "type": "numeric",
   "pipelines": "tree, linear",
   "derivation": "median non-stop duration of the route, fitted on training rows",
   "rationale": "distance proxy that generalises beyond the source/destination pair"
  },
  {
   "name": "duration_ratio",
   "type": "numeric",
   "pipelines": "tree, linear",
   "derivation": "duration_hours / route_ref_duration_hours",
   "rationale": "measures detour/layover length relative to direct"
  },
  {
   "name": "route",
   "type": "categorical (42)",
   "pipelines": "linear only",
   "derivation": "source + '-' + destination",
   "rationale": "lets a linear model fit route effects (Economy eta^2 0.111)"
  },
  {
   "name": "airline_class",
   "type": "categorical (12 observed)",
   "pipelines": "linear only",
   "derivation": "airline + '|' + class",
   "rationale": "class exists only for some airlines; linear model needs the interaction"
  },
  {
   "name": "dep_sin, dep_cos",
   "type": "numeric",
   "pipelines": "linear only",
   "derivation": "sin/cos of 2*pi*dep_minutes/1440",
   "rationale": "time of day is circular; cos has |r| 0.105 vs 0.042 for raw minutes (Economy, log fare)"
  },
  {
   "name": "log1p_days_left",
   "type": "numeric",
   "pipelines": "linear only",
   "derivation": "log(1 + days_left)",
   "rationale": "fare falls steeply then flattens: r -0.289 vs -0.274 (Economy, log fare)"
  },
  {
   "name": "log_duration_ratio",
   "type": "numeric",
   "pipelines": "linear only",
   "derivation": "log(duration_ratio)",
   "rationale": "r 0.443 vs 0.390 for raw duration (Economy, log fare); weaker inside 1-stop only (0.092 vs 0.173)"
  }
 ],
